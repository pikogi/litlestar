# ── Google Sheets ────────────────────────────────────────────────────────────
# URL del webhook de Google Apps Script para exportar leads al Sheet
# Ver instrucciones en: app/api/submit-lead/route.ts
NEXT_PUBLIC_GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/REEMPLAZAR/exec

# ── Mercado Pago ─────────────────────────────────────────────────────────────
# Access Token de PRODUCCIÓN
# Dónde encontrarlo: mercadopago.com.ar → Tu negocio → Configuración → Credenciales → Producción
MP_ACCESS_TOKEN=APP_USR-REEMPLAZAR

# URL base del sitio (sin barra final)
# Usada para las URLs de retorno después del pago
NEXT_PUBLIC_BASE_URL=https://tudominio.com

# ── Meta Conversions API ──────────────────────────────────────────────────────
# Cómo obtener los tokens:
# Events Manager → seleccioná el píxel → Configuración → Conversions API → Generar token
META_PIXEL_1_ID=919267777576799
META_PIXEL_1_TOKEN=REEMPLAZAR
META_PIXEL_2_ID=2184658699016188
META_PIXEL_2_TOKEN=REEMPLAZAR

# ── Supabase (reservas de clases particulares + panel de profes) ─────────────
# Dónde encontrarlo: supabase.com → tu proyecto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://REEMPLAZAR.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJSUZAMPLE...   # "anon public"
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJSUZAMPLE...        # "service_role" (solo server)

# ── Google Calendar (clases particulares) ────────────────────────────────────
# URL del iframe de embed del Google Calendar de disponibilidad
# Dónde encontrarlo: Google Calendar → ⚙️ Configuración → [tu calendario] →
#   "Integrar calendario" → copiar el src del <iframe>
# Ejemplo: https://calendar.google.com/calendar/embed?src=TU_ID%40group.calendar.google.com&ctz=America%2FArgentina%2FCordoba
NEXT_PUBLIC_GOOGLE_CALENDAR_EMBED_URL=https://calendar.google.com/calendar/embed?src=REEMPLAZAR
